---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/sections/Header.astro';

interface Props {
  lang: 'ru' | 'en';
  title: string;
  description: string;
  /** Header is left out on service pages (404): its anchors point at sections that are not there. */
  header?: boolean;
}
const { lang, title, description, header = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const origin = Astro.site ? Astro.site.origin : '';
const urls = { ru: `${origin}${base}/`, en: `${origin}${base}/en/` };
const ogImage = `${origin}${base}/og-${lang}.jpg`;
const ogAlt = lang === 'ru' ? 'ОСТОВ — кухни из массива и камня' : 'OSTOV — kitchens in solid wood and stone';
const skipLabel = lang === 'ru' ? 'Перейти к содержимому' : 'Skip to content';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="alternate" hreflang="ru" href={urls.ru} />
    <link rel="alternate" hreflang="en" href={urls.en} />
    <link rel="alternate" hreflang="x-default" href={urls.ru} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ОСТОВ / OSTOV" />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{skipLabel}</a>
    {header && <Header lang={lang} />}
    <main id="main">
      <slot />
    </main>
    <slot name="after-main" />
  </body>
</html>
