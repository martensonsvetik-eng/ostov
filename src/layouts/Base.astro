---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/sections/Header.astro';

interface Props {
  lang: 'ru' | 'en';
  title: string;
  description: string;
}
const { lang, title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const origin = Astro.site ? Astro.site.origin : '';
const urls = { ru: `${origin}${base}/`, en: `${origin}${base}/en/` };
const skipLabel = lang === 'ru' ? 'Перейти к содержимому' : 'Skip to content';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="alternate" hreflang="ru" href={urls.ru} />
    <link rel="alternate" hreflang="en" href={urls.en} />
    <link rel="alternate" hreflang="x-default" href={urls.ru} />
  </head>
  <body>
    <a class="skip-link" href="#main">{skipLabel}</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
  </body>
</html>
