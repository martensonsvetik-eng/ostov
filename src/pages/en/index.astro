---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/sections/Hero.astro';
import HeroPreload from '../../components/sections/HeroPreload.astro';
import Facts from '../../components/sections/Facts.astro';
import Collections from '../../components/sections/Collections.astro';
import Materials from '../../components/sections/Materials.astro';
import Projects from '../../components/sections/Projects.astro';
import Process from '../../components/sections/Process.astro';
import Pro from '../../components/sections/Pro.astro';
import Contact from '../../components/sections/Contact.astro';
import Footer from '../../components/sections/Footer.astro';
import Modal from '../../components/ui/Modal.astro';
import CatalogForm from '../../components/forms/CatalogForm.astro';
import SamplesForm from '../../components/forms/SamplesForm.astro';
import Questionnaire from '../../components/forms/Questionnaire.astro';
import { getDict } from '../../i18n';
const dict = getDict('en');
const forms = dict.forms;
---
<Base lang="en" title={dict.meta.title} description={dict.meta.description}>
  <HeroPreload slot="head" />
  <Hero lang="en" />
  <Facts lang="en" />
  <Collections lang="en" />
  <Materials lang="en" />
  <Projects lang="en" />
  <Process lang="en" />
  <Contact lang="en" />
  <Pro lang="en" />
  <Modal id="catalog" lang="en" size="sm" title={forms.catalog.title}>
    <CatalogForm lang="en" labelledby="modal-catalog-title" />
  </Modal>
  <Modal id="samples" lang="en" title={forms.samples.title}>
    <SamplesForm lang="en" labelledby="modal-samples-title" />
  </Modal>
  <Modal id="questionnaire" lang="en" title={forms.questionnaire.title}>
    <Questionnaire lang="en" labelledby="modal-questionnaire-title" />
  </Modal>
  <Footer lang="en" slot="after-main" />
</Base>
