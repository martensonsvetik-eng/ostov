---
/**
 * Questionnaire «Подготовить проект заранее» (brief.md §8.2) inside the «questionnaire»
 * modal. Five steps: object type · style by photo (one of the three collections) ·
 * materials (several) · budget and timing (the price range repeated above the budget
 * options) · contacts (the fields of §8.1). No file upload: a note says where a plan
 * would be attached. Shell and states are DemoForm.astro + form.ts; steps and draft are
 * src/scripts/questionnaire.ts. Sends nothing; method="dialog" keeps a no-JS submit
 * from navigating. All ids are prefixed «q-».
 */
import { Picture } from 'astro:assets';
import DemoForm from './DemoForm.astro';
import Field from '../ui/Field.astro';
import Choice from '../ui/Choice.astro';
import Checkbox from '../ui/Checkbox.astro';
import Button from '../ui/Button.astro';
import { getDict, type Lang } from '../../i18n';
import geometryCover from '../../assets/img/collections/geometry-cover.jpg';
import modernCover from '../../assets/img/collections/modern-cover.jpg';
import neoclassicCover from '../../assets/img/collections/neoclassic-cover.jpg';

interface Props {
  lang: Lang;
  /** id of the heading that names the form (the modal title). */
  labelledby: string;
}
const { lang, labelledby } = Astro.props;
const dict = getDict(lang);
const f = dict.forms;
const q = f.questionnaire;
const c = f.contact;
const collections = dict.collections.items;
const opts = <K extends string>(o: Record<K, string>) =>
  (Object.entries(o) as [K, string][]).map(([value, label]) => ({ value, label }));

const styles = [
  { key: 'geometry', img: geometryCover },
  { key: 'modern', img: modernCover },
  { key: 'neoclassic', img: neoclassicCover },
] as const;

const titles = [q.steps.object, q.steps.style, q.steps.materials, q.steps.budget, q.steps.contacts];
const total = titles.length;
const first = q.stepOf.split('{current}').join('1').split('{total}').join(String(total));
---
<DemoForm
  lang={lang}
  plain
  method="dialog"
  class="qform"
  submit={q.submit}
  successText={f.success.text}
  aria-labelledby={labelledby}
  data-questionnaire-form
  data-success-template={f.success.title}
  data-step-of={q.stepOf}
>
  <div class="qform__progress">
    <p class="qform__count" data-q-progress>{first}</p>
    <ol class="qform__bar" aria-hidden="true">
      {titles.map((_, i) => <li class="qform__seg" data-q-seg data-done={String(i === 0)} />)}
    </ol>
    <p class="visually-hidden" aria-live="polite" data-q-live></p>
  </div>

  <section class="qform__step" data-q-step="1" aria-labelledby="q-step-1-title">
    <h3 class="qform__title" id="q-step-1-title" tabindex="-1" data-q-title>{titles[0]}</h3>
    <Choice id="q-object" name="object" legend={q.object.label} legendHidden type="radio" required options={opts(q.object.options)} />
    <p class="qform__note">{q.planNote}</p>
  </section>

  <section class="qform__step" data-q-step="2" aria-labelledby="q-step-2-title" hidden>
    <h3 class="qform__title" id="q-step-2-title" tabindex="-1" data-q-title>{titles[1]}</h3>
    <fieldset class="qstyle">
      <legend class="qstyle__legend">{q.style.label}</legend>
      <div class="qstyle__grid">
        {styles.map(({ key, img }, i) => (
          <label class="qstyle__card" for={`q-style-${i}`}>
            <span class="qstyle__media">
              <Picture
                src={img}
                alt=""
                formats={['avif', 'webp']}
                widths={[240, 480]}
                sizes="(min-width: 768px) 13rem, 6.5rem"
                loading="lazy"
                decoding="async"
              />
            </span>
            <span class="qstyle__body">
              <span class="qstyle__row">
                <input class="qstyle__input" type="radio" id={`q-style-${i}`} name="style" value={key} required />
                <span class="qstyle__name">{collections[key].name}</span>
              </span>
              <span class="qstyle__text">{collections[key].text}</span>
            </span>
          </label>
        ))}
      </div>
    </fieldset>
  </section>

  <section class="qform__step" data-q-step="3" aria-labelledby="q-step-3-title" hidden>
    <h3 class="qform__title" id="q-step-3-title" tabindex="-1" data-q-title>{titles[2]}</h3>
    <Choice id="q-materials" name="materials" legend={q.materials.label} legendHidden hint={q.materials.hint} type="checkbox" inline options={opts(f.materials)} />
  </section>

  <section class="qform__step" data-q-step="4" aria-labelledby="q-step-4-title" hidden>
    <h3 class="qform__title" id="q-step-4-title" tabindex="-1" data-q-title>{titles[3]}</h3>
    <p class="qform__fork">{q.priceReminder}</p>
    <Choice id="q-budget" name="budget" legend={q.budget.label} type="radio" required options={opts(q.budget.options)} />
    <Choice id="q-term" name="term" legend={q.term.label} type="radio" required options={opts(q.term.options)} />
  </section>

  <section class="qform__step" data-q-step="5" aria-labelledby="q-step-5-title" hidden>
    <h3 class="qform__title" id="q-step-5-title" tabindex="-1" data-q-title>{titles[4]}</h3>
    <div class="qform__fields">
      <Field id="q-name" name="name" label={c.name} type="text" autocomplete="name" required />
      <Field id="q-phone" name="phone" label={c.phone} type="tel" inputmode="tel" autocomplete="tel" required />
    </div>
    <Choice id="q-method" name="method" legend={c.method.label} type="radio" inline required checked={['call']} options={opts(c.method.options)} />
    <Choice id="q-meeting" name="meeting" legend={c.meeting.label} type="radio" required checked={['showroom']} options={opts(c.meeting.options)} />
    <Choice id="q-who" name="who" legend={c.who.label} type="radio" inline required checked={['owner']} options={opts(c.who.options)} />
    <div class="qform__consents">
      <Checkbox id="q-consent" name="consent" label={c.consent} required />
      <Checkbox id="q-newsletter" name="newsletter" label={c.newsletter} />
    </div>
  </section>

  <Button slot="actions" variant="primary" type="button" data-q-next disabled>{f.next}</Button>
  <Button slot="actions" variant="secondary" type="button" data-q-back hidden>{f.back}</Button>
</DemoForm>

<script>
  import { initQuestionnaire } from '../../scripts/questionnaire';

  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-questionnaire-form]')) {
    initQuestionnaire(form);
  }
</script>

<style>
  /* Buttons and steps toggled with `hidden` must really disappear (.btn sets display). */
  :global(.qform [hidden]) {
    display: none !important;
  }

  .qform__progress {
    display: grid;
    gap: 0.625rem;
  }
  .qform__count {
    margin: 0;
    font-size: var(--fs-caption);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--c-muted);
  }
  .qform__bar {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .qform__seg {
    height: 2px;
    background: var(--c-hairline);
  }
  .qform__seg[data-done='true'] {
    background: var(--c-accent);
  }

  .qform__step {
    display: grid;
    gap: 1.5rem;
    animation: q-step-in var(--dur-expand) var(--ease-out);
  }

  .qform__title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.3;
  }
  .qform__title:focus {
    outline: none;
  }
  .qform__title:focus-visible {
    outline: 2px solid var(--c-focus);
    outline-offset: 4px;
  }

  .qform__note,
  .qform__fork {
    margin: 0;
    font-size: var(--fs-caption);
    line-height: 1.5;
    color: var(--c-muted);
  }
  .qform__fork {
    padding: 0.75rem 1rem;
    border-left: 2px solid var(--c-accent);
    color: var(--c-text);
  }

  .qform__fields {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 640px) {
    .qform__fields {
      grid-template-columns: 1fr 1fr;
    }
  }
  .qform__consents {
    display: grid;
    gap: 0.25rem;
  }

  /* Step 2 — style by photo */
  .qstyle {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .qstyle__legend {
    padding: 0;
    margin-bottom: 0.75rem;
    font-size: var(--fs-caption);
    font-weight: 500;
    line-height: 1.4;
  }
  .qstyle__grid {
    display: grid;
    gap: 0.75rem;
  }
  .qstyle__card {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1rem;
    align-items: center;
    min-height: var(--hit);
    padding: 0.5rem;
    border: 1px solid var(--c-hairline);
    border-radius: var(--radius);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .qstyle__card:hover {
    border-color: var(--c-text);
  }
  .qstyle__card:has(:checked) {
    border-color: var(--c-accent);
    box-shadow: inset 0 0 0 1px var(--c-accent);
  }
  .qstyle__media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--c-bg-2);
  }
  .qstyle__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .qstyle__body {
    display: grid;
    gap: 0.25rem;
  }
  .qstyle__row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .qstyle__name {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.3;
  }
  .qstyle__text {
    font-size: var(--fs-caption);
    line-height: 1.45;
    color: var(--c-muted);
  }
  .qstyle__input {
    appearance: none;
    flex: none;
    display: grid;
    place-content: center;
    width: 1.25rem;
    height: 1.25rem;
    margin: 0;
    border: 1px solid var(--c-line);
    border-radius: 50%;
    background: var(--c-bg-2);
    cursor: pointer;
  }
  .qstyle__input::before {
    content: '';
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--c-accent);
    transform: scale(0);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .qstyle__input:checked {
    border-color: var(--c-accent);
  }
  .qstyle__input:checked::before {
    transform: scale(1);
  }
  .qstyle__input:focus-visible {
    outline: 2px solid var(--c-focus);
    outline-offset: 3px;
  }

  @media (min-width: 768px) {
    .qstyle__grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .qstyle__card {
      grid-template-columns: 1fr;
      align-items: start;
      align-content: start;
    }
  }

  @keyframes q-step-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qform__step {
      animation: none;
    }
    .qstyle__input::before {
      transition: none;
    }
  }
</style>
