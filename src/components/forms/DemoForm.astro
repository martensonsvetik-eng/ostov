---
/**
 * Shared shell of every demo form (brief.md §8): error summary on top, fields (default
 * slot), foot with the server-error message, notes and the demo line above the
 * buttons, and the success block. Sends nothing: no action, the submit button is
 * type="button" until src/scripts/form.ts takes over (then type="submit" with submit
 * always prevented). All states live in this markup; the script only toggles them
 * through the data-* hooks documented in form.ts.
 *
 * Slots: default — fields; "actions" — extra buttons after the submit button.
 * Extra attributes (data-* hooks, aria-labelledby, method) go onto the <form>.
 */
import type { HTMLAttributes } from 'astro/types';
import Button from '../ui/Button.astro';
import { getDict, type Lang } from '../../i18n';

type Props = Omit<HTMLAttributes<'form'>, 'action'> & {
  lang: Lang;
  /** Visible heading inside the form (contact form); modal forms use the dialog title. */
  title?: string;
  titleId?: string;
  submit: string;
  /** Extra caption above the demo line (e.g. «Образцы привозим за 5 рабочих дней»). */
  note?: string;
  successText: string;
  /** No card frame: for forms inside a modal. */
  plain?: boolean;
};
const { lang, title, titleId, submit, note, successText, plain = false, class: className, ...rest } = Astro.props;
const f = getDict(lang).forms;
---
<form
  class:list={['dform', { 'dform--card': !plain }, className]}
  data-demo-form
  data-state="idle"
  data-errors={JSON.stringify(f.errors)}
  novalidate
  method="dialog"
  aria-labelledby={title ? titleId : undefined}
  {...rest}
>
  {title && <h3 id={titleId} class="dform__title">{title}</h3>}

  <div class="dform__summary" data-error-summary role="alert" hidden>
    <p class="dform__summary-title">{f.errorSummary}</p>
    <ul class="dform__summary-list" data-error-list></ul>
  </div>

  <div class="dform__body" data-form-body>
    <slot />

    <div class="dform__foot">
      <p class="dform__server-error" data-server-error role="alert" tabindex="-1" hidden>
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <circle cx="8" cy="8" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5" />
          <path d="M8 4.25v4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          <circle cx="8" cy="11.4" r="0.95" fill="currentColor" />
        </svg>
        <span>{f.serverError}</span>
      </p>
      <div class="dform__notes">
        {note && <p class="dform__note dform__note--lead">{note}</p>}
        <p class="dform__note">{f.demoNote}</p>
        <!-- No-JS notice: shown until the inline html.js flag (Base.astro) hides it. A <noscript>
             would do the same in browsers, but its content is not rendered as markup when
             scripting is disabled by automation, so the html.js pattern (as in Header) is used. -->
        <p class="dform__note dform__noscript" data-noscript>{f.noscript}</p>
      </div>
      <div class="dform__actions">
        <Button variant="primary" type="button" data-submit data-loading-label={f.loading}>{submit}</Button>
        <slot name="actions" />
      </div>
    </div>
  </div>

  <div class="dform__success" data-success hidden>
    <h3 class="dform__success-title" data-success-title tabindex="-1"></h3>
    <p class="dform__success-text">{successText}</p>
    <Button variant="secondary" type="button" data-form-reset>{f.again}</Button>
  </div>
</form>

<style>
  .dform {
    display: grid;
    gap: 2rem;
  }
  .dform--card {
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem);
    background: var(--c-bg-2);
    border: 1px solid var(--c-hairline);
    border-radius: var(--radius);
  }

  .dform__title,
  .dform__success-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 1.8rem + 0.8vw, 2.5rem); /* serif only from 32 px (§6) */
    font-weight: 500;
    line-height: var(--lh-heading);
    margin: 0;
  }

  .dform__success-title:focus {
    outline: none;
  }
  .dform__success-title:focus-visible {
    outline: 2px solid var(--c-focus);
    outline-offset: 4px;
  }

  .dform[data-state='success'] .dform__title {
    display: none;
  }

  .dform__summary {
    scroll-margin-top: calc(var(--header-h, 64px) + 1.5rem);
    padding: 1rem 1.25rem;
    border: 1px solid var(--c-error);
    border-left-width: 4px;
    border-radius: var(--radius);
    color: var(--c-text);
  }
  .dform__summary[hidden] {
    display: none;
  }
  .dform__summary-title {
    margin: 0 0 0.5rem;
    font-weight: 600;
    color: var(--c-error);
  }
  .dform__summary-list {
    margin: 0;
    padding-left: 1.25rem;
    display: grid;
    gap: 0;
    font-size: var(--fs-caption);
  }
  /* Each link is a 44 px tap row (brief §10.2), so the list needs no extra gap. */
  .dform__summary-list :global(a) {
    display: inline-flex;
    align-items: center;
    min-width: var(--hit);
    min-height: var(--hit);
    color: var(--c-link);
    text-underline-offset: 0.2em;
  }
  .dform__summary-list :global(a:focus-visible) {
    outline: 2px solid var(--c-focus);
    outline-offset: 2px;
  }

  .dform__body {
    display: grid;
    gap: 1.75rem;
  }
  .dform__body[hidden] {
    display: none;
  }

  .dform__foot {
    display: grid;
    gap: 1rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--c-hairline);
  }

  .dform__server-error {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 0;
    padding: 0.875rem 1rem;
    border: 1px solid var(--c-error);
    border-left-width: 4px;
    border-radius: var(--radius);
    color: var(--c-error);
    line-height: 1.45;
  }
  .dform__server-error[hidden] {
    display: none;
  }
  .dform__server-error svg {
    flex: none;
    margin-top: 0.15em;
  }
  .dform__server-error:focus {
    outline: none;
  }
  .dform__server-error:focus-visible {
    outline: 2px solid var(--c-focus);
    outline-offset: 2px;
  }

  .dform__notes {
    display: grid;
    gap: 0.25rem;
  }
  .dform__note {
    margin: 0;
    font-size: var(--fs-caption);
    line-height: 1.5;
    color: var(--c-muted);
  }
  .dform__note--lead {
    color: var(--c-text);
  }

  :global(html.js) .dform__noscript {
    display: none;
  }

  .dform__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
  }

  @media (max-width: 479px) {
    .dform__actions > :global(*) {
      width: 100%;
    }
  }

  .dform__success {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .dform__success[hidden] {
    display: none;
  }
  .dform__success-text {
    margin: 0;
    max-width: 36em;
  }
</style>
