---
/**
 * Main demo form «Записаться на обсуждение» (brief.md §8.1). Sends nothing: no action,
 * the button is type="button" until src/scripts/form.ts takes over (then type="submit"
 * with submit always prevented). All states live in this markup; the script only
 * toggles them through data-* hooks (see form.ts).
 */
import Field from '../ui/Field.astro';
import Choice from '../ui/Choice.astro';
import Checkbox from '../ui/Checkbox.astro';
import Button from '../ui/Button.astro';
import { getDict, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const f = getDict(Astro.props.lang).forms;
const c = f.contact;
const opts = <K extends string>(o: Record<K, string>) =>
  (Object.entries(o) as [K, string][]).map(([value, label]) => ({ value, label }));
---
<form
  class="cform"
  data-demo-form
  data-contact-form
  data-state="idle"
  data-errors={JSON.stringify(f.errors)}
  data-success-template={f.success.title}
  novalidate
  aria-labelledby="cform-title"
>
  <h3 id="cform-title" class="cform__title">{c.title}</h3>

  <div class="cform__summary" data-error-summary role="alert" hidden>
    <p class="cform__summary-title">{f.errorSummary}</p>
    <ul class="cform__summary-list" data-error-list></ul>
  </div>

  <div class="cform__body" data-form-body>
    <div class="cform__fields">
      <Field id="contact-name" name="name" label={c.name} type="text" autocomplete="name" required />
      <Field id="contact-phone" name="phone" label={c.phone} type="tel" inputmode="tel" autocomplete="tel" required />
    </div>

    <Choice id="contact-method" name="method" legend={c.method.label} type="radio" inline required checked={['call']} options={opts(c.method.options)} />
    <Choice id="contact-meeting" name="meeting" legend={c.meeting.label} type="radio" required checked={['showroom']} options={opts(c.meeting.options)} />
    <Choice id="contact-who" name="who" legend={c.who.label} type="radio" inline required checked={['owner']} options={opts(c.who.options)} />

    <div class="cform__consents">
      <Checkbox id="contact-consent" name="consent" label={c.consent} required />
      <Checkbox id="contact-newsletter" name="newsletter" label={c.newsletter} />
    </div>

    <div class="cform__foot">
      <p class="cform__server-error" data-server-error role="alert" tabindex="-1" hidden>
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <circle cx="8" cy="8" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5" />
          <path d="M8 4.25v4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          <circle cx="8" cy="11.4" r="0.95" fill="currentColor" />
        </svg>
        <span>{f.serverError}</span>
      </p>
      <p class="cform__note">{f.demoNote}</p>
      <!-- No-JS notice: shown until the inline html.js flag (Base.astro) hides it. A <noscript>
           would do the same in browsers, but its content is not rendered as markup when
           scripting is disabled by automation, so the html.js pattern (as in Header) is used. -->
      <p class="cform__note cform__noscript" data-noscript>{f.noscript}</p>
      <div class="cform__actions">
        <Button variant="primary" type="button" data-submit data-loading-label={f.loading}>{c.submit}</Button>
        <Button variant="secondary" type="button" data-open-modal="questionnaire" aria-haspopup="dialog">{c.prepare}</Button>
      </div>
    </div>
  </div>

  <div class="cform__success" data-success hidden>
    <h3 class="cform__success-title" data-success-title tabindex="-1"></h3>
    <p class="cform__success-text">{f.success.text}</p>
    <Button variant="secondary" type="button" data-form-reset>{f.again}</Button>
  </div>
</form>

<script>
  import { initForm } from '../../scripts/form';

  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-contact-form]')) {
    const template = form.dataset.successTemplate ?? '{name}';
    initForm(
      form,
      {
        name: 'name',
        phone: 'phone',
        method: 'choice',
        meeting: 'choice',
        who: 'choice',
        consent: 'consent',
        newsletter: 'optional',
      },
      // «Спасибо, {name}» + «.» — the text paragraph follows (brief.md §8.1).
      (data) => `${template.replace('{name}', String(data.get('name') ?? '').trim())}.`,
    );
  }
</script>

<style>
  .cform {
    display: grid;
    gap: 2rem;
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem);
    background: var(--c-bg-2);
    border: 1px solid var(--c-hairline);
    border-radius: var(--radius);
  }

  .cform__title,
  .cform__success-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 1.8rem + 0.8vw, 2.5rem); /* serif only from 32 px (§6) */
    font-weight: 500;
    line-height: var(--lh-heading);
    margin: 0;
  }

  .cform__success-title:focus {
    outline: none;
  }
  .cform__success-title:focus-visible {
    outline: 2px solid var(--c-focus);
    outline-offset: 4px;
  }

  .cform[data-state='success'] .cform__title {
    display: none;
  }

  .cform__summary {
    scroll-margin-top: calc(var(--header-h, 64px) + 1.5rem);
    padding: 1rem 1.25rem;
    border: 1px solid var(--c-error);
    border-left-width: 4px;
    border-radius: var(--radius);
    color: var(--c-text);
  }
  .cform__summary[hidden] {
    display: none;
  }
  .cform__summary-title {
    margin: 0 0 0.5rem;
    font-weight: 600;
    color: var(--c-error);
  }
  .cform__summary-list {
    margin: 0;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.25rem;
    font-size: var(--fs-caption);
  }
  .cform__summary-list :global(a) {
    display: inline-block;
    min-height: 1.5rem;
    color: var(--c-link);
    text-underline-offset: 0.2em;
  }
  .cform__summary-list :global(a:focus-visible) {
    outline: 2px solid var(--c-focus);
    outline-offset: 2px;
  }

  .cform__body {
    display: grid;
    gap: 1.75rem;
  }
  .cform__body[hidden] {
    display: none;
  }

  .cform__fields {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .cform__fields {
      grid-template-columns: 1fr 1fr;
    }
  }

  .cform__consents {
    display: grid;
    gap: 0.25rem;
  }

  .cform__foot {
    display: grid;
    gap: 1rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--c-hairline);
  }

  .cform__server-error {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 0;
    padding: 0.875rem 1rem;
    border: 1px solid var(--c-error);
    border-left-width: 4px;
    border-radius: var(--radius);
    color: var(--c-error);
    line-height: 1.45;
  }
  .cform__server-error[hidden] {
    display: none;
  }
  .cform__server-error svg {
    flex: none;
    margin-top: 0.15em;
  }
  .cform__server-error:focus {
    outline: none;
  }
  .cform__server-error:focus-visible {
    outline: 2px solid var(--c-focus);
    outline-offset: 2px;
  }

  .cform__note {
    margin: 0;
    font-size: var(--fs-caption);
    line-height: 1.5;
    color: var(--c-muted);
  }

  :global(html.js) .cform__noscript {
    display: none;
  }

  .cform__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
  }

  @media (max-width: 479px) {
    .cform__actions > :global(*) {
      width: 100%;
    }
  }

  .cform__success {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  .cform__success[hidden] {
    display: none;
  }
  .cform__success-text {
    margin: 0;
    max-width: 36em;
  }
</style>
