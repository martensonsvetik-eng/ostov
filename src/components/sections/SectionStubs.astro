---
/** Temporary anchor targets so header links and section highlighting work; later tasks replace each section. */
import { getDict } from '../../i18n';
import type { Lang } from '../../i18n';

interface Props {
  lang: Lang;
  /** Which stubs to render here (page order: projects, process, contact, pro). */
  only: ('projects' | 'process' | 'pro')[];
}
const t = getDict(Astro.props.lang);
const sections = [
  ['projects', t.projects.title],
  ['process', t.process.title],
  ['pro', t.pro.title],
] as const;
---
{sections.filter(([id]) => Astro.props.only.includes(id)).map(([id, title]) => (
  <section id={id} class="section stub" aria-labelledby={`${id}-title`}>
    <div class="container"><h2 id={`${id}-title`}>{title}</h2></div>
  </section>
))}

<style>
  .stub {
    min-height: 80vh;
  }
</style>
