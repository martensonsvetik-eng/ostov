---
/**
 * Sticky header (brief.md §4): wordmark, section anchors, RU/EN switch, CTA.
 * On phones: wordmark + short CTA + menu button; the rest lives in a full-screen menu.
 * The wordmark is Cormorant Garamond 600 converted to paths (brief.md §11).
 */
import { getDict } from '../../i18n';
import type { Lang } from '../../i18n';
import Button from '../ui/Button.astro';
import { logoPaths } from './logo-paths';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDict(lang).header;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const langHref = { ru: `${base}/`, en: `${base}/en/` };
const logo = logoPaths[lang];
const nav: [string, string][] = [
  ['#collections', t.nav.collections],
  ['#projects', t.nav.projects],
  ['#process', t.nav.process],
  ['#pro', t.nav.pro],
  ['#contact', t.nav.showroom],
];
---
<header class="site-header">
  <div class="container site-header__bar">
    <a class="site-header__logo" href={langHref[lang]} aria-label={t.logo}>
      <svg width={logo.w} height="28" viewBox={`0 0 ${logo.w} 28`} fill="currentColor" aria-hidden="true" focusable="false">
        <path d={logo.d} />
      </svg>
    </a>

    <div class="site-header__panel" id="site-menu">
      <nav class="site-header__nav" aria-label={t.navLabel}>
        <ul>
          {nav.map(([href, label]) => (
            <li><a href={href}>{label}</a></li>
          ))}
        </ul>
      </nav>
      <div class="site-header__lang" role="group" aria-label={t.langLabel}>
        <a href={langHref.ru} data-lang-link={langHref.ru} lang="ru" hreflang="ru" aria-current={lang === 'ru' ? 'true' : undefined}>{t.langRu}</a>
        <a href={langHref.en} data-lang-link={langHref.en} lang="en" hreflang="en" aria-current={lang === 'en' ? 'true' : undefined}>{t.langEn}</a>
      </div>
    </div>

    <Button variant="primary" href="#contact" class="site-header__cta">
      <span class="site-header__cta-long">{t.cta}</span>
      <span class="site-header__cta-short">{t.ctaShort}</span>
    </Button>

    <button
      class="site-header__menu-btn"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
      aria-label={t.menuOpen}
      data-label-open={t.menuOpen}
      data-label-close={t.menuClose}
    >
      <span class="site-header__burger" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--header-h);
    background: var(--c-bg);
    border-bottom: 1px solid var(--c-hairline);
  }
  .site-header__bar {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 100%;
  }
  .site-header__logo {
    display: inline-flex;
    align-items: center;
    min-height: var(--hit);
    margin-right: auto;
    color: var(--c-text);
  }

  /* CTA: compact on phones; the long label shows from the desktop breakpoint. */
  .site-header :global(.site-header__cta) {
    min-height: var(--hit);
    padding: 0 1rem;
    font-size: 0.875rem;
  }
  .site-header__cta-long {
    display: none;
  }

  .site-header__menu-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--hit);
    height: var(--hit);
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--c-text);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .site-header__burger {
    position: relative;
    width: 24px;
    height: 14px;
  }
  .site-header__burger span {
    position: absolute;
    left: 0;
    width: 24px;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .site-header__burger span:first-child {
    top: 0;
  }
  .site-header__burger span:last-child {
    bottom: 0;
  }
  .site-header[data-open] .site-header__burger span:first-child {
    transform: translateY(6px) rotate(45deg);
  }
  .site-header[data-open] .site-header__burger span:last-child {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Phone: full-screen menu below the bar. */
  .site-header__panel {
    position: fixed;
    inset: 0;
    z-index: 0;
    display: none;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding: calc(var(--header-h) + 2rem) var(--gutter) 2.5rem;
    background: var(--c-bg);
    overflow-y: auto;
  }
  .site-header[data-open] .site-header__panel {
    display: flex;
    animation: menu-in var(--dur-fast) var(--ease-out);
  }
  .site-header__nav ul {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-header__nav a {
    display: block;
    padding: 0.5rem 0;
    min-height: var(--hit);
    border-bottom: 1px solid var(--c-hairline);
    color: var(--c-text);
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 500;
    line-height: 1.3;
    text-decoration: none;
  }
  .site-header__lang {
    display: flex;
    gap: 0.5rem;
  }
  .site-header__lang a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: var(--hit);
    min-height: var(--hit);
    padding: 0 0.5rem;
    color: var(--c-muted);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-decoration: none;
  }
  .site-header :is(.site-header__nav, .site-header__lang) a[aria-current='true'] {
    color: var(--c-text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.4em;
  }

  @keyframes menu-in {
    from {
      opacity: 0;
    }
  }

  /* Desktop: inline nav, no menu button. */
  @media (min-width: 73.75em) {
    .site-header__bar {
      gap: 1.5rem;
    }
    .site-header__logo {
      margin-right: 0;
    }
    .site-header__menu-btn {
      display: none;
    }
    .site-header__panel {
      position: static;
      display: flex;
      flex: 1;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      padding: 0;
      overflow: visible;
      background: none;
    }
    .site-header__nav ul {
      flex-direction: row;
      gap: 1.5rem;
    }
    .site-header__nav a {
      display: inline-flex;
      align-items: center;
      padding: 0;
      border: 0;
      font-family: var(--font-sans);
      font-size: 0.875rem;
      font-weight: 500;
      letter-spacing: 0.01em;
      white-space: nowrap;
      color: var(--c-muted);
    }
    .site-header__nav a:hover {
      color: var(--c-text);
    }
    .site-header :global(.site-header__cta) {
      padding: 0 1.25rem;
    }
    .site-header__cta-long {
      display: inline;
    }
    .site-header__cta-short {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__burger span {
      transition: none;
    }
    .site-header[data-open] .site-header__panel {
      animation: none;
    }
  }
</style>

<style is:global>
  html.menu-open {
    overflow: hidden;
  }
</style>

<script>
  import { initHeader } from '../../scripts/header';
  const el = document.querySelector<HTMLElement>('header.site-header');
  if (el) initHeader(el);
</script>
