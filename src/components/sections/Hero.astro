---
/**
 * Блок 1 — первый экран (brief.md §5). One static photo, text over a graphite
 * scrim in two layers (src/lib/hero-scrim.ts): a light one under the H1, a
 * stronger one under the subtitle and buttons. Both are grid items stretched over
 * the rows they protect, so they follow the text whatever its wrapping.
 * H1, subtitle and the primary CTA fit the first screen from 360×740 up (§10.2).
 *
 * Living layer (brief.md §6, «Анимация»), quiet and short:
 * - entrance, CSS only, once per load: H1 words, subtitle and actions rise 14 px and fade in,
 *   staggered. Needs JS (html.js) and allowed motion, so the text is never held back without
 *   JS or with reduced motion. Keyframes have no `to` and use `backwards` fill: they end on
 *   the element's own style and leave nothing behind;
 * - desktop «morning light» (src/scripts/hero.ts): a warm glow overlay under the scrims
 *   follows the pointer.
 * The photo itself never moves on load or with the pointer; its only motion is the desktop
 * GSAP scroll parallax on the <img> (motion.ts).
 */
import Button from '../ui/Button.astro';
import { getDict, type Lang } from '../../i18n';
import { getHeroImage } from '../../lib/hero-image';
import { SCRIM_BASE_ALPHA, SCRIM_LOWER_ALPHA, LIGHT_RGB, LIGHT_ALPHA } from '../../lib/hero-scrim';

interface Props {
  lang: Lang;
}
const t = getDict(Astro.props.lang).hero;
const { sources, img } = await getHeroImage();
// H1 words as inline-blocks, so each can rise on its own (transform needs a box); spaces stay text.
const esc = (v: string) => v.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const words = t.title.split(' ');
const titleHtml = words.map((w, i) => `<span class="hero__w" style="--i: ${i}">${esc(w)}</span>`).join(' ');
const light = `rgb(${[1, 3, 5].map((i) => parseInt(LIGHT_RGB.slice(i, i + 2), 16)).join(' ')}`;
---
<section
  class="hero on-dark"
  aria-labelledby="hero-title"
  data-hero
  style={`--scrim-base: ${SCRIM_BASE_ALPHA}; --scrim-lower: ${SCRIM_LOWER_ALPHA}; --light-in: ${light} / ${LIGHT_ALPHA}); --light-mid: ${light} / ${(LIGHT_ALPHA * 0.45).toFixed(3)}); --light-out: ${light} / 0); --words: ${words.length}`}
>
  <picture class="hero__media" data-hero-media>
    {sources.map((s) => (
      <source media={s.media} type={s.type} srcset={s.srcset} sizes={s.sizes} width={s.width} height={s.height} />
    ))}
    <img
      src={img.src}
      srcset={img.srcset}
      sizes={img.sizes}
      width={img.width}
      height={img.height}
      alt={t.imageAlt}
      loading="eager"
      fetchpriority="high"
      data-parallax
    />
  </picture>
  <div class="hero__light" data-hero-light aria-hidden="true"></div>

  <div class="hero__body">
    <div class="hero__scrim hero__scrim--base" data-hero-scrim aria-hidden="true"></div>
    <div class="hero__scrim hero__scrim--lower" aria-hidden="true"></div>
    <div class="container hero__head">
      <h1 id="hero-title" class="hero__title" set:html={titleHtml} />
    </div>
    <div class="container hero__lower">
      <p class="hero__sub hero__enter" style="--step: 0" data-hero-sub>{t.subtitle}</p>
      <div class="hero__actions">
        <Button variant="primary" href="#contact" class="hero__enter" style="--step: 1" data-hero-cta>{t.cta}</Button>
        <Button variant="link" href="#projects" class="hero__enter" style="--step: 2" data-hero-more>{t.secondary}</Button>
      </div>
    </div>
  </div>
</section>

<script>
  import { initHeroLight } from '../../scripts/hero';
  initHeroLight();
</script>

<style>
  .hero {
    /* .on-dark: light text roles; its graphite background shows until the photo loads. */
    --fade: clamp(6rem, 20svh, 13rem);
    --text-max: 46rem;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: clamp(34rem, calc(100svh - var(--header-h)), 68rem);
    overflow: clip;
    /* The glow blends with the photo only, never with what is behind the section. */
    isolation: isolate;
  }

  .hero__media,
  .hero__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero__media img {
    max-width: none;
    object-fit: cover;
    object-position: 50% 50%;
  }

  /* Row 1: H1. Row 2: subtitle + actions. Scrims share the cells of the text they protect. */
  .hero__body {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto auto;
  }
  .hero__head {
    grid-area: 1 / 1;
    position: relative;
  }
  .hero__lower {
    grid-area: 2 / 1;
    position: relative;
    padding-bottom: clamp(2.5rem, 1.5rem + 4vw, 5.5rem);
  }

  /*
   * Each layer is solid over its rows and fades out above them (negative margin
   * stretches the grid item upward). Eased stops keep the fade free of banding.
   */
  .hero__scrim {
    --a: var(--scrim-base);
    --f: var(--fade);
    align-self: stretch;
    margin-top: calc(-1 * var(--f));
    background: linear-gradient(
      to top,
      rgb(36 34 31 / var(--a)) 0,
      rgb(36 34 31 / var(--a)) calc(100% - var(--f)),
      rgb(36 34 31 / calc(var(--a) * 0.7)) calc(100% - var(--f) * 0.7),
      rgb(36 34 31 / calc(var(--a) * 0.38)) calc(100% - var(--f) * 0.42),
      rgb(36 34 31 / calc(var(--a) * 0.12)) calc(100% - var(--f) * 0.16),
      rgb(36 34 31 / 0) 100%
    );
    pointer-events: none;
  }
  .hero__scrim--base {
    grid-area: 1 / 1 / 3 / 2;
  }
  .hero__scrim--lower {
    --a: var(--scrim-lower);
    /* Solid from the subtitle down; fades up across the whole H1 (≈ two lines) so the
       step between the two layers reads as a gradient, not a band. Over the H1 it only adds. */
    --f: max(clamp(6rem, 4.5rem + 4vw, 10rem), calc(var(--fs-h1) * 3.2));
    grid-area: 2 / 1;
  }

  .hero__title {
    max-width: min(16em, 100%);
    color: var(--c-text);
    letter-spacing: -0.015em;
    line-height: 1.02;
    /* Line box of the last line sits fully inside row 1. */
    padding-bottom: 0.08em;
  }

  .hero__sub {
    max-width: 30rem;
    padding-top: clamp(1.25rem, 0.9rem + 1vw, 1.75rem);
    color: var(--c-text);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 2rem;
    margin-top: clamp(1.75rem, 1.2rem + 1.6vw, 2.75rem);
  }
  /* Optical alignment: the link's 2 px side padding would push its text off the left edge. */
  .hero__actions :global([data-hero-more]) {
    margin-inline-start: -0.125rem;
  }

  /* Phone turned sideways (short, wide screen): the whole first screen — H1, subtitle and
     both actions — fits in the viewport. The H1 is sized from the height, not the width. */
  @media (orientation: landscape) and (max-height: 32rem) {
    .hero {
      --fs-h1: clamp(2rem, 11svh, 3.25rem);
      height: max(18rem, calc(100svh - var(--header-h)));
    }
    .hero__sub {
      max-width: 34rem;
      padding-top: 0.75rem;
    }
    .hero__actions {
      margin-top: 1.25rem;
    }
    .hero__lower {
      padding-bottom: 1.5rem;
    }
  }

  /* Desktop: the scrim keeps to the text column and lets the right of the frame
     breathe. Fully opaque up to 3rem past the widest text line (--text-end). */
  @media (min-width: 1024px) {
    .hero__scrim {
      /* The H1 is the widest line: two lines ≈ 10.8em; the column is capped by the container. */
      --title-w: min(calc(var(--fs-h1) * 11), 100% - 2 * var(--gutter), var(--container));
      --text-end: calc(max(var(--gutter), (100% - var(--container)) / 2) + max(var(--text-max), var(--title-w)));
      mask-image: linear-gradient(
        to right,
        #000 0,
        #000 calc(var(--text-end) + 3rem),
        rgb(0 0 0 / 0.72) calc(var(--text-end) + 12rem),
        rgb(0 0 0 / 0.4) calc(var(--text-end) + 22rem),
        rgb(0 0 0 / 0.14) calc(var(--text-end) + 32rem),
        transparent calc(var(--text-end) + 44rem)
      );
    }
    .hero__actions {
      max-width: var(--text-max);
    }
  }

  /* ---- Living layer (brief.md §6, «Анимация»; header comment) ---- */

  .hero__title :global(.hero__w) {
    display: inline-block;
  }

  .hero__light {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Entrance: starts with the first paint, no JS wait. Delay per step ≈ 90 ms. */
    :global(html.js) .hero__title :global(.hero__w),
    :global(html.js) .hero :global(.hero__enter) {
      animation: hero-rise 700ms var(--ease-out) backwards;
      animation-delay: calc(var(--i, 0) * 90ms + 60ms);
    }
    :global(html.js) .hero :global(.hero__enter) {
      animation-delay: calc((var(--words) + var(--step)) * 90ms + 60ms);
    }

    /* Pointer light: mouse-like pointers only (src/scripts/hero.ts). Under the scrims. */
    @media (hover: hover) and (pointer: fine) {
      .hero__light {
        display: block;
        position: absolute;
        top: 0;
        left: 0;
        width: 64rem;
        height: 64rem;
        margin: -32rem 0 0 -32rem;
        border-radius: 50%;
        background: radial-gradient(closest-side, var(--light-in), var(--light-mid) 45%, var(--light-out));
        mix-blend-mode: screen;
        opacity: 0;
        pointer-events: none;
      }
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
</style>
