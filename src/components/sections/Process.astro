---
/**
 * Блок 6 — «Как мы работаем» + FAQ (brief.md §5). Four numbered stages with durations,
 * then a five-question accordion, all collapsed by default.
 * Accordion (§6 + global motion rule): height is not animated — the answer is shown at
 * once and its content fades/rises with opacity + transform; the «+» turns into «×» by
 * rotation. Nothing moves under reduced motion. Without JS every answer is shown.
 */
import { getDict, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const d = getDict(Astro.props.lang);
const t = d.process;
const faq = d.faq;
const stepKeys = ['0', '1', '2', '3'] as const;
const faqKeys = ['0', '1', '2', '3', '4'] as const;
---
<section id="process" class="section process" aria-labelledby="process-title" data-faq>
  <div class="container">
    <h2 id="process-title" class="process__title" data-reveal>{t.title}</h2>

    <ol class="steps" aria-label={t.stepsLabel} data-steps>
      {stepKeys.map((k, i) => (
        <li class="step" data-reveal>
          <span class="step__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="step__title" data-step-title>{t.steps[k].title}</h3>
          <p class="step__duration" data-step-duration>{t.steps[k].duration}</p>
        </li>
      ))}
    </ol>

    <div class="faq" data-reveal>
      <h3 id="faq-title" class="faq__title">{faq.title}</h3>
      <ul class="faq__list" role="list" aria-labelledby="faq-title">
        {faqKeys.map((k) => {
          const id = `faq-${k}-answer`;
          return (
            <li class="faq__item">
              <h4 class="faq__q">
                <button
                  type="button"
                  class="faq__toggle"
                  aria-expanded="false"
                  aria-controls={id}
                  data-faq-toggle
                >
                  <span class="faq__q-text">{faq.items[k].q}</span>
                  <span class="faq__icon" aria-hidden="true"></span>
                </button>
              </h4>
              <div id={id} class="faq__answer" data-faq-answer hidden>
                <p class="faq__answer-inner">{faq.items[k].a}</p>
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</section>

<script>
  import { initFaq } from '../../scripts/faq';
  const root = document.querySelector<HTMLElement>('[data-faq]');
  if (root) initFaq(root);
</script>

<style>
  .process__title {
    max-width: 14em;
    margin-bottom: clamp(2.5rem, 1.5rem + 3.5vw, 5rem);
  }

  /* ---------- Stages ---------- */
  .steps {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0 var(--grid-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .step {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    column-gap: 0.75rem;
    align-content: start;
    padding-block: 1.5rem;
    border-top: 1px solid var(--c-hairline);
  }
  .step__num {
    grid-row: 1 / span 2;
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 500;
    line-height: 1;
    color: var(--c-accent);
  }
  .step__duration {
    margin-top: 0.25rem;
    color: var(--c-muted);
  }

  /* ---------- FAQ ---------- */
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem var(--grid-gap);
    margin-top: clamp(4rem, 3rem + 4vw, 7rem);
  }
  .faq__title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 1.7rem + 1vw, 2.5rem);
    font-weight: 600;
    line-height: var(--lh-heading);
  }
  .faq__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--c-hairline);
  }
  .faq__item {
    border-top: 1px solid var(--c-hairline);
  }
  .faq__q {
    margin: 0;
    font: inherit;
  }
  .faq__toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    min-height: var(--hit);
    padding: 1.25rem 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    font-weight: 500;
    line-height: 1.35;
    text-align: start;
    cursor: pointer;
  }
  @media (hover: hover) {
    .faq__toggle:hover .faq__q-text {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.2em;
    }
  }

  /* «+» from two hairlines; turns into «×» by rotation only. */
  .faq__icon {
    position: relative;
    flex: none;
    width: 1rem;
    height: 1rem;
    color: var(--c-accent);
    transition: transform var(--dur-expand) var(--ease-out);
  }
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1.5px;
    margin-top: -0.75px;
    background: currentColor;
  }
  .faq__icon::after {
    transform: rotate(90deg);
  }
  .faq__toggle[aria-expanded='true'] .faq__icon {
    transform: rotate(45deg);
  }

  .faq__answer-inner {
    max-width: 40rem;
    padding-bottom: 1.5rem;
    color: var(--c-muted);
  }
  :global(html.js) .faq__answer:not([hidden]) .faq__answer-inner {
    animation: faq-reveal var(--dur-expand) var(--ease-out) both;
  }
  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* No JS: answers are simply shown; the «+» would promise an action that does nothing. */
  :global(html:not(.js)) .faq__answer[hidden] {
    display: block;
  }
  :global(html:not(.js)) .faq__icon {
    display: none;
  }
  :global(html:not(.js)) .faq__toggle {
    cursor: auto;
  }

  @media (min-width: 768px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .step {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.75rem;
      padding-block: 2rem 0;
    }
    .step__num {
      grid-row: auto;
      font-size: 2.5rem;
    }
    .step__duration {
      margin-top: 0;
    }
    .faq {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .faq__title {
      grid-column: 1 / span 4;
    }
    .faq__list {
      grid-column: 5 / -1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__icon {
      transition: none;
    }
    :global(html.js) .faq__answer:not([hidden]) .faq__answer-inner {
      animation: none;
    }
  }
</style>
