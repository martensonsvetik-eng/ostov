---
/**
 * Блок 5 — «Проекты» (brief.md §5). The lead case «Дом у сосен» gets an editorial spread:
 * a large photo with the name, facts and story beside it, then the client's quote set
 * large next to a line-drawn floor plan. Three smaller cards follow (photo, name, place,
 * budget, timing). The «place · budget · timing · note» line comes from the dictionary as
 * one string (like the contact price list) and is split here into a <dl>.
 * The plan is an inline SVG in token colours with its <title> from the dictionary.
 * Photos are local placeholders (TODO-asset, credits.md) until stock is approved.
 * Interaction (client round 3, brief.md §6): three material hotspots on the lead photo
 * (disclosure buttons with a tooltip card) and a quiet 3D tilt on the three cards —
 * both driven by src/scripts/projects.ts.
 */
import { Picture } from 'astro:assets';
import { getDict, type Lang } from '../../i18n';
import pines from '../../assets/img/projects/pines.jpg';
import patriarshy from '../../assets/img/projects/patriarshy.jpg';
import jurmala from '../../assets/img/projects/jurmala.jpg';
import vasilievsky from '../../assets/img/projects/vasilievsky.jpg';

interface Props {
  lang: Lang;
}
const t = getDict(Astro.props.lang).projects;

const FORMATS = ['avif', 'webp'] as const;
// Lead photo: full width below 1024 px, 7 of 12 columns from there (1320 px container).
const LEAD_SIZES = '(min-width: 1400px) 760px, (min-width: 1024px) 56vw, 100vw';
const CARD_SIZES = '(min-width: 1400px) 424px, (min-width: 768px) 31vw, 100vw';

/** «Москва · 3,2 млн ₽ · 13 недель · note» → parts; the note is optional. */
function splitMeta(meta: string) {
  const [place = '', budget = '', duration = '', ...rest] = meta.split(' · ').map((s) => s.trim());
  return { place, budget, duration, note: rest.join(' · ') };
}

const lead = { ...t.main, ...splitMeta(t.main.meta) };
const cards = (['0', '1', '2'] as const).map((k, i) => ({
  key: k,
  ...t.cards[k],
  ...splitMeta(t.cards[k].meta),
  image: [patriarshy, jurmala, vasilievsky][i]!,
}));
const planTitleId = `projects-plan-title-${Astro.props.lang}`;
/** Hotspot positions in % of the 3:2 photo (the frame is 3:2 too, so no cropping shifts them). */
const hotspots = [
  { key: 'stairs', x: 47, y: 41 },
  { key: 'island', x: 30, y: 82 },
  { key: 'fronts', x: 72, y: 89 },
] as const;
---
<section id="projects" class="section projects" aria-labelledby="projects-title">
  <div class="container">
    <h2 id="projects-title" class="projects__title" data-reveal>{t.title}</h2>

    <article class="lead" data-project="main" aria-labelledby="project-main-name">
      <div class="lead__media" data-reveal>
        <Picture
          src={pines}
          alt={lead.imageAlt}
          formats={[...FORMATS]}
          widths={[480, 800, 1200, 1600]}
          sizes={LEAD_SIZES}
          loading="lazy"
          decoding="async"
        />
        <div class="hotspots" role="group" aria-label={t.main.hotspotsLabel} data-hotspots>
          {hotspots.map((h) => {
            const item = t.main.hotspots[h.key];
            const tipId = `hotspot-${h.key}-${Astro.props.lang}`;
            return (
              <div class="hotspot" style={`--x: ${h.x}%; --y: ${h.y}%`} data-hotspot={h.key}>
                <button
                  type="button"
                  class="hotspot__btn"
                  aria-expanded="false"
                  aria-controls={tipId}
                  data-hotspot-toggle
                >
                  <span class="hotspot__dot" aria-hidden="true" />
                  <span class="visually-hidden">{item.title}</span>
                </button>
                <div id={tipId} class="hotspot__tip" data-hotspot-tip hidden>
                  <p class="hotspot__title" aria-hidden="true">{item.title}</p>
                  <p class="hotspot__text">{item.text}</p>
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <div class="lead__body" data-reveal>
        <h3 id="project-main-name" class="lead__name">{lead.name}</h3>
        <dl class="meta lead__meta">
          <div><dt class="visually-hidden">{t.metaLabels.place}</dt><dd data-project-place>{lead.place}</dd></div>
          <div><dt class="visually-hidden">{t.metaLabels.budget}</dt><dd data-project-budget>{lead.budget}</dd></div>
          <div><dt class="visually-hidden">{t.metaLabels.duration}</dt><dd data-project-duration>{lead.duration}</dd></div>
        </dl>
        <p class="lead__text">{lead.text}</p>
      </div>

      <figure class="lead__quote" data-reveal>
        <blockquote>
          <p>{lead.quote}</p>
        </blockquote>
        <figcaption class="caption">— {lead.quoteCite}</figcaption>
      </figure>

      <figure class="lead__plan" data-reveal>
        <svg
          class="plan"
          viewBox="0 0 480 320"
          role="img"
          aria-labelledby={planTitleId}
          data-project-plan
          xmlns="http://www.w3.org/2000/svg"
        >
          <title id={planTitleId}>{lead.planAlt}</title>
          <!-- Kitchen units along two walls: tall run on the left, cooking run under the top wall. -->
          <g class="plan__units">
            <rect x="26" y="26" width="58" height="210" />
            <rect x="84" y="26" width="150" height="58" />
            <line x1="26" y1="96" x2="84" y2="96" />
            <line x1="26" y1="166" x2="84" y2="166" />
            <line x1="134" y1="26" x2="134" y2="84" />
            <line x1="184" y1="26" x2="184" y2="84" />
          </g>
          <!-- Cooktop and sink as simple symbols. -->
          <g class="plan__fixtures">
            <circle cx="148" cy="46" r="8" /><circle cx="170" cy="46" r="8" />
            <circle cx="148" cy="66" r="6" /><circle cx="170" cy="66" r="6" />
            <rect x="36" y="186" width="38" height="34" rx="4" />
          </g>
          <!-- The island: oak body and travertine top as one piece (no joint line). -->
          <rect class="plan__island" x="170" y="150" width="180" height="66" />
          <g class="plan__units">
            <circle cx="200" cy="232" r="9" /><circle cx="240" cy="232" r="9" /><circle cx="280" cy="232" r="9" /><circle cx="320" cy="232" r="9" />
          </g>
          <!-- Dining table. -->
          <g class="plan__units">
            <circle cx="404" cy="214" r="32" />
          </g>
          <!-- Walls with a window opening on top and a door opening at the bottom. -->
          <path
            class="plan__walls"
            d="M260 20 H20 V300 H320 M380 300 H460 V20 H430"
          />
          <!-- Window: frame lines in the opening. -->
          <g class="plan__window">
            <line x1="260" y1="16" x2="430" y2="16" />
            <line x1="260" y1="24" x2="430" y2="24" />
            <line x1="260" y1="14" x2="260" y2="26" />
            <line x1="430" y1="14" x2="430" y2="26" />
          </g>
          <!-- Door swing. -->
          <path class="plan__door" d="M380 300 V246 M380 246 A54 54 0 0 0 326 300" />
        </svg>
        <figcaption class="caption">{lead.planLabel}</figcaption>
      </figure>
    </article>

    <ul class="cards" role="list">
      {cards.map((c) => (
        <li data-reveal data-tilt>
          <article class="card" data-project={c.key} aria-labelledby={`project-${c.key}-name`}>
            <div class="card__media">
              <Picture
                src={c.image}
                alt={c.imageAlt}
                formats={[...FORMATS]}
                widths={[400, 640, 880, 1200]}
                sizes={CARD_SIZES}
                loading="lazy"
                decoding="async"
              />
            </div>
            <h3 id={`project-${c.key}-name`} class="card__name">{c.name}</h3>
            <dl class="meta">
              <div><dt class="visually-hidden">{t.metaLabels.place}</dt><dd data-project-place>{c.place}</dd></div>
              <div><dt class="visually-hidden">{t.metaLabels.budget}</dt><dd data-project-budget>{c.budget}</dd></div>
              <div><dt class="visually-hidden">{t.metaLabels.duration}</dt><dd data-project-duration>{c.duration}</dd></div>
            </dl>
            {c.note && <p class="card__note">{c.note}</p>}
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import { initHotspots, initTilt } from '../../scripts/projects';
  const root = document.querySelector<HTMLElement>('#projects');
  if (root) {
    initHotspots(root);
    initTilt(root);
  }
</script>

<style>
  .projects__title {
    max-width: 14em;
    margin-bottom: clamp(2.5rem, 1.5rem + 3.5vw, 5rem);
  }

  /* ---------- Lead case ---------- */
  .lead {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.75rem, 1.25rem + 2vw, 3rem) var(--grid-gap);
  }

  .lead__media {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--c-hairline);
  }
  .lead__media :global(img),
  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lead__name {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 1.6rem + 1.6vw, 3rem);
    font-weight: 500;
    line-height: var(--lh-heading);
  }
  .lead__meta {
    margin-top: 1rem;
  }
  .lead__text {
    max-width: 32rem;
    margin-top: 1.5rem;
  }

  .lead__quote {
    margin: 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--c-hairline);
  }
  .lead__quote blockquote {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 1.35rem + 1.6vw, 2.75rem);
    font-style: italic;
    font-weight: 500;
    line-height: 1.2;
  }
  .lead__quote blockquote p {
    text-wrap: balance;
  }
  /* Quote marks are typographic decoration, so they live in CSS, per language. */
  .lead__quote blockquote p::before {
    content: '«';
  }
  .lead__quote blockquote p::after {
    content: '»';
  }
  :global(html[lang='en']) .lead__quote blockquote p::before {
    content: '“';
  }
  :global(html[lang='en']) .lead__quote blockquote p::after {
    content: '”';
  }
  .lead__quote figcaption {
    margin-top: 1rem;
  }

  .lead__plan {
    margin: 0;
    max-width: 28rem;
  }
  .lead__plan figcaption {
    margin-top: 0.75rem;
  }
  .plan {
    width: 100%;
    height: auto;
    color: var(--c-text);
    background: var(--c-bg-2);
    border: 1px solid var(--c-hairline);
  }
  .plan__walls {
    fill: none;
    stroke: currentColor;
    stroke-width: 8;
    stroke-linecap: square;
  }
  .plan__units,
  .plan__fixtures {
    fill: none;
    stroke: var(--c-muted);
    stroke-width: 1.5;
  }
  .plan__island {
    fill: var(--c-hairline);
    stroke: currentColor;
    stroke-width: 2;
  }
  .plan__window {
    stroke: var(--c-accent);
    stroke-width: 2;
  }
  .plan__door {
    fill: none;
    stroke: var(--c-muted);
    stroke-width: 1.5;
    stroke-dasharray: 4 4;
  }

  /* ---------- Shared «place · budget · timing» line ---------- */
  .meta {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    color: var(--c-muted);
  }
  .meta > div + div::before {
    content: '·';
    display: inline-block;
    margin-inline: 0.5em;
  }
  .meta > div {
    display: flex;
  }
  .meta dd {
    margin: 0;
  }
  .meta [data-project-budget] {
    white-space: nowrap;
  }

  /* ---------- Three cards ---------- */
  .cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(3rem, 2rem + 3vw, 4rem) var(--grid-gap);
    margin: clamp(4rem, 3rem + 4vw, 7rem) 0 0;
    padding: clamp(2.5rem, 2rem + 2vw, 4rem) 0 0;
    border-top: 1px solid var(--c-hairline);
    list-style: none;
  }
  .card__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--c-hairline);
  }
  .card__name {
    margin-top: clamp(1.25rem, 1rem + 0.8vw, 1.75rem);
  }
  .card .meta {
    position: relative;
    margin-top: 0.5rem;
  }
  /* Hover: the separator dots stretch into short dashes and a hairline is drawn from the
     centre outwards under the line (materials draw theirs left to right). scaleX only. */
  .card .meta::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.3rem;
    height: 1px;
    background: var(--c-accent);
    transform: scaleX(0);
    transition: transform 700ms var(--ease-out);
  }
  .card .meta > div + div::before {
    transition: transform 500ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .cards > li:hover .meta::after {
      transform: scaleX(1);
    }
    .cards > li:hover .meta > div + div::before {
      transform: scaleX(2.4);
    }
  }
  .card__note {
    margin-top: 0.625rem;
    font-size: var(--fs-caption);
    color: var(--c-muted);
  }

  /* ---------- Round 3: hotspots on the lead photo ---------- */
  .lead__media {
    position: relative;
  }
  .lead__media :global(picture),
  .card__media :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* A gentle approach on hover; the hotspot layer is not scaled (3 % moves a dot ~5 px). */
  .lead__media :global(picture) {
    transition: transform 900ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .lead__media:hover :global(picture) {
      transform: scale(1.03);
    }
  }

  .hotspots {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  :global(html:not(.js)) .hotspots {
    display: none;
  }
  .hotspot {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 0;
    height: 0;
  }
  /* Dots stay above an open card, so a card never hides another dot. */
  .hotspot__btn {
    position: absolute;
    z-index: 3;
    left: calc(var(--hit) / -2);
    top: calc(var(--hit) / -2);
    display: grid;
    place-items: center;
    width: var(--hit);
    height: var(--hit);
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
    pointer-events: auto;
  }
  /* Warm white dot with a graphite ring: reads on the white walls and on the walnut. */
  .hotspot__dot {
    position: relative;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--c-bg);
    box-shadow:
      0 0 0 1.5px rgb(36 34 31 / 0.55),
      0 2px 8px rgb(36 34 31 / 0.25);
    transition: transform 300ms var(--ease-out);
  }
  .hotspot__dot::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: 50%;
    border: 1.5px solid var(--c-bg);
    opacity: 0;
  }
  /* A dot under the centre of an open card steps back (projects.ts sets data-covered). */
  .hotspot__btn {
    transition: opacity 200ms var(--ease-out);
  }
  .hotspot[data-covered] .hotspot__btn {
    opacity: 0;
    pointer-events: none;
  }
  .hotspot__btn:hover .hotspot__dot,
  .hotspot__btn[aria-expanded='true'] .hotspot__dot {
    transform: scale(1.25);
  }
  .hotspot__btn:focus-visible {
    outline: 2px solid var(--c-bg);
    outline-offset: -4px;
    box-shadow: 0 0 0 2px var(--c-dark) inset;
  }
  /* Pulse: three slow breaths once the photo is in view (4.6 s with the stagger, under the
     5 s of WCAG 2.2.2), then the dots rest. */
  .hotspots.is-pulsing .hotspot__dot::after {
    animation: project-hotspot-pulse 1.4s var(--ease-out) 3;
  }
  .hotspots.is-pulsing .hotspot:nth-child(2) .hotspot__dot::after {
    animation-delay: 200ms;
  }
  .hotspots.is-pulsing .hotspot:nth-child(3) .hotspot__dot::after {
    animation-delay: 400ms;
  }
  @keyframes project-hotspot-pulse {
    0% {
      opacity: 0.9;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(2.6);
    }
  }

  /* Tooltip card: opaque warm white under graphite text, so contrast never depends on
     the photo. projects.ts sets its left/top/width so it stays inside the frame. */
  .hotspot__tip {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 2;
    width: 15rem;
    padding: 0.875rem 1rem 1rem;
    background: var(--c-bg-2);
    color: var(--c-text);
    box-shadow: 0 12px 32px rgb(36 34 31 / 0.18);
    pointer-events: auto;
  }
  :global(html.js) .hotspot__tip:not([hidden]) {
    animation: project-hotspot-tip 360ms var(--ease-out) both;
  }
  :global(html.js) .hotspot__tip[data-side='bottom']:not([hidden]) {
    animation-name: project-hotspot-tip-down;
  }
  @keyframes project-hotspot-tip {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes project-hotspot-tip-down {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .hotspot__title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.15;
  }
  .hotspot__text {
    margin-top: 0.375rem;
    font-size: var(--fs-caption);
    line-height: 1.45;
    color: var(--c-muted);
  }

  /* ---------- Round 3: card tilt ---------- */
  /* projects.ts writes rotateX/rotateY on the photo frame, an opposite translate3d on the photo
     and the glare position (--gx/--gy); it only runs for a fine pointer with motion allowed. */
  /* Only the photo frame tilts; the name and meta line stay flat and crisp. */
  .card {
    perspective: 1200px;
  }
  .card__media {
    position: relative;
    transform-origin: 50% 50%;
  }
  .card__media::after {
    content: '';
    position: absolute;
    left: -50%;
    top: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle at center, rgb(255 250 240 / 0.3), rgb(255 250 240 / 0) 32%);
    opacity: 0;
    transform: translate3d(var(--gx, 0px), var(--gy, 0px), 0);
    transition: opacity 500ms var(--ease-out);
    pointer-events: none;
  }
  .card.is-tilting .card__media::after {
    opacity: 1;
  }

  @media (min-width: 768px) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Editorial spread: photo 7 columns, story in the last 4; quote and plan below. */
  @media (min-width: 1024px) {
    .lead {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      row-gap: clamp(3rem, 2rem + 2vw, 4.5rem);
      align-items: start;
    }
    .lead__media {
      grid-column: 1 / span 7;
      grid-row: 1;
    }
    .lead__body {
      grid-column: 9 / -1;
      grid-row: 1;
      align-self: end;
    }
    .lead__quote {
      grid-column: 2 / span 6;
      grid-row: 2;
      padding-top: 2.5rem;
    }
    .lead__plan {
      grid-column: 9 / -1;
      grid-row: 2;
      max-width: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lead__media :global(picture),
    .hotspot__btn,
    .hotspot__dot,
    .card__media::after,
    .card .meta::after,
    .card .meta > div + div::before {
      transition: none;
    }
    .hotspots.is-pulsing .hotspot__dot::after,
    :global(html.js) .hotspot__tip:not([hidden]),
    :global(html.js) .hotspot__tip[data-side='bottom']:not([hidden]) {
      animation: none;
    }
  }
</style>
