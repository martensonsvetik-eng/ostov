---
/**
 * Text field (brief.md §8.1): always-visible label, error text under the field
 * with an icon and a coloured border, linked via aria-describedby.
 */
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'input'>, 'name' | 'type'> & {
  name: string;
  label: string;
  type: 'text' | 'tel' | 'email';
  required?: boolean;
  inputmode?: HTMLAttributes<'input'>['inputmode'];
  autocomplete?: HTMLAttributes<'input'>['autocomplete'];
  error?: string;
  id?: string;
};

const {
  name,
  label,
  type,
  required = false,
  inputmode,
  autocomplete,
  error,
  id = `f-${name}`,
  class: className,
  ...rest
} = Astro.props;

const errorId = `${id}-error`;
---
<div class:list={['field', { 'field--invalid': error }, className]}>
  <label class="field__label" for={id}>{label}</label>
  <input
    class="field__input"
    id={id}
    name={name}
    type={type}
    required={required}
    inputmode={inputmode}
    autocomplete={autocomplete}
    aria-invalid={error ? 'true' : undefined}
    aria-describedby={error ? errorId : undefined}
    {...rest}
  />
  <p class="field__error" id={errorId} hidden={!error}>
    <svg class="field__icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
      <circle cx="8" cy="8" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5" />
      <path d="M8 4.25v4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      <circle cx="8" cy="11.4" r="0.95" fill="currentColor" />
    </svg>
    <span class="field__error-text">{error}</span>
  </p>
</div>

<style>
  .field {
    display: grid;
    gap: 0.5rem;
  }

  .field__label {
    font-size: var(--fs-caption);
    font-weight: 500;
    line-height: 1.4;
    color: var(--c-text);
  }

  .field__input {
    width: 100%;
    min-height: 3.25rem;
    padding: 0 1rem;
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    background: var(--c-bg-2);
    color: var(--c-dark);
    font: 400 1rem/1.4 var(--font-sans); /* ≥16 px: no iOS zoom on focus */
    /* No transition: only transform/opacity may animate; border changes are instant. */
  }

  .field__input:hover {
    border-color: var(--c-text);
  }

  .field__input:focus-visible {
    outline: 2px solid var(--c-focus);
    outline-offset: 2px;
    border-color: var(--c-accent);
  }

  .field--invalid .field__input {
    border-color: var(--c-error);
    box-shadow: inset 0 0 0 1px var(--c-error);
  }

  .field__error {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 0;
    font-size: var(--fs-caption);
    line-height: 1.45;
    color: var(--c-error);
  }

  .field__error[hidden] {
    display: none;
  }

  .field__icon {
    flex: none;
    margin-top: 0.1em;
  }
</style>
