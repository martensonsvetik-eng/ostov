---
/**
 * Group of radio buttons or checkboxes inside a fieldset with a visible legend.
 * Each option row is at least 44 px tall. Errors use text + icon + colour.
 */
interface Option {
  value: string;
  label: string;
}

interface Props {
  name: string;
  legend: string;
  type: 'radio' | 'checkbox';
  options: Option[];
  checked?: string[];
  required?: boolean;
  hint?: string;
  error?: string;
  inline?: boolean;
}

const {
  name,
  legend,
  type,
  options,
  checked = [],
  required = false,
  hint,
  error,
  inline = false,
} = Astro.props;

const base = `c-${name}`;
const hintId = `${base}-hint`;
const errorId = `${base}-error`;
const describedBy = [hint && hintId, error && errorId].filter(Boolean).join(' ') || undefined;
---
<fieldset class:list={['choice', { 'choice--inline': inline, 'choice--invalid': error }]} aria-describedby={describedBy}>
  <legend class="choice__legend">{legend}</legend>
  {hint && <p class="choice__hint" id={hintId}>{hint}</p>}
  <div class="choice__options">
    {
      options.map((o, i) => (
        <label class="choice__option" for={`${base}-${i}`}>
          <input
            class={`choice__input choice__input--${type}`}
            type={type}
            id={`${base}-${i}`}
            name={name}
            value={o.value}
            checked={checked.includes(o.value)}
            required={required && (type === 'radio' || options.length === 1)}
            aria-invalid={error ? 'true' : undefined}
          />
          <span class="choice__label">{o.label}</span>
        </label>
      ))
    }
  </div>
  <p class="choice__error" id={errorId} hidden={!error}>
    <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
      <circle cx="8" cy="8" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5" />
      <path d="M8 4.25v4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      <circle cx="8" cy="11.4" r="0.95" fill="currentColor" />
    </svg>
    <span>{error}</span>
  </p>
</fieldset>

<style>
  .choice {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .choice__legend {
    padding: 0;
    margin-bottom: 0.5rem;
    font-size: var(--fs-caption);
    font-weight: 500;
    line-height: 1.4;
    color: var(--c-text);
  }

  .choice__hint {
    margin: -0.25rem 0 0.5rem;
    font-size: var(--fs-caption);
    color: var(--c-muted);
  }

  .choice__options {
    display: grid;
    gap: 0;
  }

  .choice--inline .choice__options {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1.75rem;
  }

  .choice__option {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: var(--hit);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .choice__input {
    appearance: none;
    flex: none;
    display: grid;
    place-content: center;
    width: 1.25rem;
    height: 1.25rem;
    margin: 0;
    border: 1px solid var(--c-line);
    background: var(--c-bg-2);
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .choice__input--radio {
    border-radius: 50%;
  }

  .choice__input--checkbox {
    border-radius: var(--radius);
  }

  .choice__option:hover .choice__input {
    border-color: var(--c-text);
  }

  .choice__input:focus-visible {
    outline: 2px solid var(--c-focus);
    outline-offset: 3px;
  }

  .choice__input--radio::before {
    content: '';
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--c-accent);
    transform: scale(0);
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .choice__input--radio:checked {
    border-color: var(--c-accent);
  }

  .choice__input--radio:checked::before {
    transform: scale(1);
  }

  .choice__input--checkbox::before {
    content: '';
    width: 0.7rem;
    height: 0.4rem;
    margin-top: -0.15rem;
    border-left: 1.5px solid var(--c-on-accent);
    border-bottom: 1.5px solid var(--c-on-accent);
    transform: rotate(-45deg) scale(0);
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .choice__input--checkbox:checked {
    border-color: var(--c-accent);
    background: var(--c-accent);
  }

  .choice__input--checkbox:checked::before {
    transform: rotate(-45deg) scale(1);
  }

  .choice__input[aria-invalid='true'] {
    border-color: var(--c-error);
    box-shadow: inset 0 0 0 1px var(--c-error);
  }

  .choice__label {
    font-size: 1rem;
    line-height: 1.4;
  }

  .choice__error {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 0.25rem 0 0;
    font-size: var(--fs-caption);
    line-height: 1.45;
    color: var(--c-error);
  }

  .choice__error[hidden] {
    display: none;
  }

  .choice__error svg {
    flex: none;
    margin-top: 0.1em;
  }
</style>
